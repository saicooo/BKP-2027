
import pandas as pd
from datasets import load_dataset

# Load the dataset in streaming mode
dataset = load_dataset(
    "AdoCleanCode/Fakeddit",
    split="train",
    streaming=True
)

# Shuffle a limited stream and inspect 5,000 examples
sample = list(
    dataset.shuffle(seed=42, buffer_size=10_000).take(5_000)
)

# Keep only the fields we need
df = pd.DataFrame([
    {
        "id": row["id"],
        "text": row["text"],
        "label": row["6_way_label"],
        "label_name": row["label_name"],
        "has_image": row["hasImage"],
        "image_url": row["image_url"]
    }
    for row in sample
])

# Save a small metadata file
output_path = "/content/fakeddit_sample.csv"
df.to_csv(output_path, index=False)

print("Saved:", output_path)
print("Number of records:", len(df))
print("\nLabel distribution:")
print(df["label_name"].value_counts(dropna=False))

print("\nImages available:")
print(df["has_image"].value_counts(dropna=False))

print("\nFirst 3 records:")
print(df[["id", "text", "label_name", "has_image"]].head(3).to_string(index=False))
