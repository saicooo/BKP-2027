
import numpy as np
import pandas as pd

from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    classification_report,
    confusion_matrix
)
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline

# Load saved BERT embeddings and metadata
X = np.load("/content/bert_embeddings.npy")
data = pd.read_csv("/content/metadata_with_splits.csv")

y = data["target"].to_numpy()
splits = data["split"].to_numpy()

X_train = X[splits == "train"]
y_train = y[splits == "train"]

X_val = X[splits == "validation"]
y_val = y[splits == "validation"]

X_test = X[splits == "test"]
y_test = y[splits == "test"]

print("Train:", X_train.shape)
print("Validation:", X_val.shape)
print("Test:", X_test.shape)

# Train baseline model
model = make_pipeline(
    StandardScaler(),
    LogisticRegression(
        max_iter=1000,
        class_weight="balanced",
        random_state=42
    )
)

model.fit(X_train, y_train)

# Evaluate on validation and test sets
for name, X_part, y_part in [
    ("Validation", X_val, y_val),
    ("Test", X_test, y_test)
]:
    predictions = model.predict(X_part)

    print(f"\n=== {name} Results ===")
    print("Accuracy:", round(accuracy_score(y_part, predictions), 4))
    print("Precision:", round(
        precision_score(y_part, predictions, zero_division=0), 4
    ))
    print("Recall:", round(
        recall_score(y_part, predictions, zero_division=0), 4
    ))
    print("F1:", round(
        f1_score(y_part, predictions, zero_division=0), 4
    ))

    if name == "Test":
        print("\nClassification report:")
        print(classification_report(
            y_part,
            predictions,
            target_names=["True", "Other categories"],
            zero_division=0
        ))

        print("Confusion matrix:")
        print(confusion_matrix(y_part, predictions))

# Save the trained baseline
import joblib

joblib.dump(model, "/content/bert_logistic_baseline.joblib")
print("\nSaved: /content/bert_logistic_baseline.joblib")
