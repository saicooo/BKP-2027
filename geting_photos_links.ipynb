
import re
import pandas as pd
from urllib.parse import urlparse

df = pd.read_csv("/content/metadata_with_clean_image_urls.csv")

def extract_image_url(value):
    if pd.isna(value):
        return None

    value = str(value).strip()

    # Extract the destination URL from Markdown syntax
    match = re.search(r"\]\((https?://.*)\)\s*$", value)

    if match:
        value = match.group(1)

    # Remove Markdown escaping
    value = value.replace(r"\&", "&").replace(r"\_", "_")

    # Remove accidental surrounding characters
    value = value.strip().strip("<>")

    parsed = urlparse(value)
    if parsed.scheme in ("http", "https") and parsed.netloc:
        return value

    return None

df["clean_image_url"] = df["image_url"].apply(extract_image_url)

print("Total records:", len(df))
print("Valid URLs:", int(df["clean_image_url"].notna().sum()))
print("Missing URLs:", int(df["clean_image_url"].isna().sum()))

print("\nCleaned examples:")
for url in df["clean_image_url"].dropna().head(5):
    print(url)

df.to_csv("/content/metadata_with_clean_image_urls.csv", index=False)
print("\nSaved corrected metadata.")
