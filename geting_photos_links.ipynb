
import re
import pandas as pd
from urllib.parse import urlparse

df = pd.read_csv("/content/metadata_with_splits.csv")

def extract_image_url(value):
    if pd.isna(value):
        return None

    value = str(value).strip()

    # Extract URL from Markdown: [text](URL)
    match = re.search(r"\]\((https?://[^)]+)\)", value)
    if match:
        value = match.group(1)

    # Handle escaped ampersands
    value = value.replace(r"\&", "&")

    # Validate URL format
    parsed = urlparse(value)
    if parsed.scheme in ("http", "https") and parsed.netloc:
        return value

    return None

df["clean_image_url"] = df["image_url"].apply(extract_image_url)

print("Total records:", len(df))
print("Valid image URLs:", int(df["clean_image_url"].notna().sum()))
print("Missing/invalid URLs:", int(df["clean_image_url"].isna().sum()))

print("\nExamples of cleaned URLs:")
for url in df["clean_image_url"].dropna().head(5):
    print(url)

print("\nImage availability by split:")
print(
    df.groupby("split")["clean_image_url"]
      .agg(total="count")
)

df.to_csv("/content/metadata_with_clean_image_urls.csv", index=False)
print("\nSaved: /content/metadata_with_clean_image_urls.csv")
