import pandas as pd
import re
import requests
from PIL import Image
from io import BytesIO

df = pd.read_csv("/content/metadata_with_splits.csv")

def clean_url(value):
    if pd.isna(value):
        return None

    value = str(value).strip()

    # Extract the destination from a Markdown link
    match = re.search(r'\]\((https?://[^)]+)\)', value)

    if match:
        return match.group(1)

    # Keep an already-direct URL
    if value.startswith(("http://", "https://")):
        return value

    return None

df["clean_image_url"] = df["image_url"].apply(clean_url)

print("Original:", repr(df.loc[df["image_url"].notna(), "image_url"].iloc[0]))
print("Cleaned:", repr(df.loc[df["clean_image_url"].notna(), "clean_image_url"].iloc[0]))
print("Valid URLs:", df["clean_image_url"].notna().sum())

url = df.loc[df["clean_image_url"].notna(), "clean_image_url"].iloc[0]

try:
    response = requests.get(
        url,
        headers={"User-Agent": "Mozilla/5.0"},
        timeout=15
    )

    print("HTTP status:", response.status_code)
    response.raise_for_status()

    image = Image.open(BytesIO(response.content))
    print("Image size:", image.size)
    print("Image format:", image.format)
    display(image)

except Exception as e:
    print("Download failed:", repr(e))
