duplicates = df[
    df["text"].duplicated(keep=False)
].sort_values("text")

print("Rows with repeated texts:", len(duplicates))
print("Unique repeated texts:", duplicates["text"].nunique())

print("\nExamples of repeated texts:")
display(
    duplicates[
        ["id", "text", "label_name"]
    ].head(20)
)

print("\nRepeated texts with conflicting labels:")

label_counts = (
    duplicates.groupby("text")["label_name"]
    .nunique()
)

conflicts = label_counts[label_counts > 1]

print("Number of texts with different labels:", len(conflicts))

if len(conflicts) > 0:
    display(
        duplicates[
            duplicates["text"].isin(conflicts.index)
        ][["id", "text", "label_name"]].head(20)
    )
