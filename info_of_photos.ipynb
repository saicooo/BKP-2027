import pandas as pd
import numpy as np
import torch
import requests
import re
import os
import time

from PIL import Image
from io import BytesIO
from torchvision import models

# Load metadata
df = pd.read_csv("/content/metadata_with_splits.csv")

def clean_url(value):
    if pd.isna(value):
        return None

    value = str(value).strip()
    match = re.search(r'\]\((https?://[^)]+)\)', value)

    if match:
        return match.group(1).replace(r"\&", "&").replace(r"\_", "_")

    if value.startswith(("http://", "https://")):
        return value

    return None

df["clean_image_url"] = df["image_url"].apply(clean_url)

# Load pretrained ResNet18
weights = models.ResNet18_Weights.DEFAULT
model = models.resnet18(weights=weights)
model.fc = torch.nn.Identity()
model.eval()

preprocess = weights.transforms()

# Output files
features_path = "/content/cnn_image_features.npy"
ids_path = "/content/cnn_image_feature_ids.csv"
failed_path = "/content/cnn_image_failed.csv"

# Select records that have image URLs
image_df = df[df["clean_image_url"].notna()]

features = []
successful_ids = []
failed_records = []

total = len(image_df)

for count, (idx, row) in enumerate(image_df.iterrows(), start=1):
    try:
        response = requests.get(
            row["clean_image_url"],
            headers={"User-Agent": "Mozilla/5.0"},
            timeout=15
        )
        response.raise_for_status()

        image = Image.open(BytesIO(response.content)).convert("RGB")
        image_tensor = preprocess(image).unsqueeze(0)

        with torch.no_grad():
            feature = model(image_tensor).squeeze(0).numpy()

        features.append(feature)
        successful_ids.append(idx)

    except Exception as e:
        failed_records.append({
            "row_index": idx,
            "image_url": row["clean_image_url"],
            "error": str(e)
        })

    # Save progress every 100 records
    if count % 100 == 0 or count == total:
        if features:
            np.save(features_path, np.stack(features))
            pd.DataFrame({"row_index": successful_ids}).to_csv(
                ids_path, index=False
            )

        pd.DataFrame(failed_records).to_csv(failed_path, index=False)

        print(
            f"Processed {count}/{total} | "
            f"Success: {len(features)} | Failed: {len(failed_records)}"
        )

print("\nFinished")
print("Total attempted:", total)
print("Successful:", len(features))
print("Failed:", len(failed_records))

if features:
    print("Feature matrix:", np.load(features_path).shape)

print("Saved:", features_path)
print("Saved:", ids_path)
print("Saved:", failed_path)
