
import pandas as pd

df = pd.read_csv("/content/metadata_with_splits.csv")

print("Dataset shape:", df.shape)
print("\nColumns:")
print(df.columns.tolist())

image_columns = [
    col for col in df.columns
    if any(word in col.lower() for word in ["image", "img", "photo", "url"])
]

print("\nPossible image-related columns:", image_columns)

for col in image_columns:
    print(f"\n--- {col} ---")
    print("Non-null values:", df[col].notna().sum())
    print(df[col].dropna().head(5).to_list())
