import numpy as np
import pandas as pd
import torch
from transformers import AutoTokenizer, AutoModel
from tqdm.auto import tqdm

# Load the three prepared splits
train_df = pd.read_csv("/content/train.csv")
val_df = pd.read_csv("/content/validation.csv")
test_df = pd.read_csv("/content/test.csv")

# Preserve the split information
train_df["split"] = "train"
val_df["split"] = "validation"
test_df["split"] = "test"

data = pd.concat(
    [train_df, val_df, test_df],
    ignore_index=True
)

# Load BERT
model_name = "bert-base-uncased"
device = torch.device(
    "cuda" if torch.cuda.is_available() else "cpu"
)

print("Device:", device)

tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModel.from_pretrained(model_name).to(device)
model.eval()

texts = data["text"].fillna("").astype(str).tolist()
all_embeddings = []

# Extract BERT CLS embeddings in batches
batch_size = 16

with torch.inference_mode():
    for start in tqdm(range(0, len(texts), batch_size)):
        batch_texts = texts[start:start + batch_size]

        inputs = tokenizer(
            batch_texts,
            padding=True,
            truncation=True,
            max_length=128,
            return_tensors="pt"
        )

        inputs = {
            key: value.to(device)
            for key, value in inputs.items()
        }

        outputs = model(**inputs)
        embeddings = outputs.last_hidden_state[:, 0, :]

        all_embeddings.append(
            embeddings.cpu().numpy()
        )

X_text = np.concatenate(all_embeddings, axis=0)

# Save embeddings and matching metadata
np.save("/content/bert_embeddings.npy", X_text)
data.to_csv("/content/metadata_with_splits.csv", index=False)

print("\nBERT feature extraction complete")
print("Embedding shape:", X_text.shape)
print("Metadata rows:", len(data))
print("Saved: /content/bert_embeddings.npy")
print("Saved: /content/metadata_with_splits.csv")
